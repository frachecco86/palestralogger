{
  "name": "palestralogger",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-wasm.mjs && vite",
    "prebuild": "node scripts/copy-wasm.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "icons": "node scripts/gen-icons.mjs",
    "deploy": "npm run build && npx netlify deploy --prod --dir=dist",
    "smoke": "vite build --ssr scripts/smoke-db.ts --outDir .smoke --emptyOutDir && node .smoke/smoke-db.js"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql.js": "^1.15.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.2",
    "adm-zip": "^0.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1"
  },
  "description": "PalestraLogger — diario allenamenti mobile offline con SQLite, calendario e statistiche"
}
